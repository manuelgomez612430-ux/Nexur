<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurar Acceso"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/slate_900" />

        <TextView
            android:id="@+id/tvCollabInfoSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="👤 Colaborador: ...\n🆔 DNI: ..."
            android:textColor="@color/slate_600"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_50"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROLES ASIGNADOS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/purple_600"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:id="@+id/layoutRolesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PERMISOS DE GESTIÓN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/purple_600"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:id="@+id/layoutPermissionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmAccept"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="ACEPTAR Y GUARDAR"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/purple_600" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAccept"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="CANCELAR"
            android:textColor="@color/slate_400" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
