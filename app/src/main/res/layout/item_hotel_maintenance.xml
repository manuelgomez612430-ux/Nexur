<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvRoomLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Habitación 101"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/slate_900" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="PENDIENTE"
                android:textSize="10sp"
                app:chipMinHeight="24dp"
                app:chipBackgroundColor="@color/orange_600"
                android:textColor="@color/white" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Falla en la cerradura de la puerta principal."
            android:textSize="14sp"
            android:textColor="@color/slate_600"
            android:layout_marginTop="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPhoto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/ivReportPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reportado: 22/08 18:30"
                android:textSize="11sp"
                android:textColor="@color/slate_400" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkFixed"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marcar Solucionado"
                android:textSize="12sp"
                android:textColor="@color/green_600" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
