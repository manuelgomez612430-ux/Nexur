<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerBuyerHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gomezmart_bg_marketplace">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/buyerViewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cardBottomNavContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- BACKDROP PARA CERRAR EL MENÚ FLOTANTE AL TOCAR FUERA -->
        <View
            android:id="@+id/viewInterfaceBackdrop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="#1A000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cardBottomNavContainer" />

        <!-- MENÚ FLOTANTE DE OPCIONES DE INTERFAZ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInterfaceMenuOverlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:layout_constraintBottom_toTopOf="@id/cardBottomNavContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/includeInterfaceOptions"
                layout="@layout/dialog_interface_options" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white"
            app:cardUseCompatPadding="false"
            app:cardPreventCornerOverlap="false"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- BLOQUE INDICADOR DINÁMICO RECTANGULAR CUADRADO -->
                <View
                    android:id="@+id/navIndicatorCustom"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_indicator_pill"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Custom Navigation Layout -->
                <LinearLayout
                    android:id="@+id/layoutCustomNav"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                        android:id="@+id/btnNavHome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvIconHome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🛒"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/tvActiveOrdersBadge"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="-4dp"
                                android:layout_marginEnd="-4dp"
                                android:background="@drawable/bg_circle_green"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mercado"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <!-- CHATS -->
                    <LinearLayout
                        android:id="@+id/btnNavChats"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvIconChats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📬"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/tvUnreadBadgeChats"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="-4dp"
                                android:layout_marginEnd="-4dp"
                                android:background="@drawable/bg_circle_red"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLabelChats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chats"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_500" />
                    </LinearLayout>

                    <!-- CUENTA -->
                    <LinearLayout
                        android:id="@+id/btnNavAccount"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">
                        <TextView
                            android:id="@+id/tvIconAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👤"
                            android:textSize="22sp" />
                        <TextView
                            android:id="@+id/tvLabelAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cuenta"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_500" />
                    </LinearLayout>

                    <!-- AJUSTES -->
                    <LinearLayout
                        android:id="@+id/btnNavSettings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">
                        <TextView
                            android:id="@+id/tvIconSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚙️"
                            android:textSize="22sp" />
                        <TextView
                            android:id="@+id/tvLabelSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ajustes"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_500" />
                    </LinearLayout>

                    <!-- VOLVER A GESTIÓN (DINÁMICO) -->
                    <LinearLayout
                        android:id="@+id/btnNavGestion"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/tvIconGestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐"
                            android:textSize="22sp" />
                        <TextView
                            android:id="@+id/tvLabelGestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interfaz"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_500" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Menu -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navBuyerHome"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/menu_buyer_drawer"
        app:headerLayout="@layout/drawer_header_buyer" />

</androidx.drawerlayout.widget.DrawerLayout>