<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/slate_50">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivSelectionLogo"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="fitCenter"
            android:src="@drawable/gomezmart_icon"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvSelectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Qué vamos a gestionar hoy?"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/slate_900"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSelectionSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona el tipo de rubro para tu cuenta de negocio"
        android:textSize="16sp"
        android:textColor="@color/slate_600"
        android:layout_marginBottom="32dp"
        android:textAlignment="center" />

    <!-- STEP 1: PRODUCTS VS SERVICES -->
    <LinearLayout
        android:id="@+id/layoutStep1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProductsCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="🛍️"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_light_purple"
                    android:layout_marginEnd="16dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Venta de Productos"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_900" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiendas, bodegas y almacenes"
                        android:textSize="14sp"
                        android:textColor="@color/slate_500" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardServicesCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="✨"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_light_blue"
                    android:layout_marginEnd="16dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Servicios Especializados"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_900" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Préstamos, hoteles y atención"
                        android:textSize="14sp"
                        android:textColor="@color/slate_500" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- STEP 2: SERVICES SPECIALTY (HIDDEN INITIALLY) -->
    <LinearLayout
        android:id="@+id/layoutStep2Services"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="💵"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_light_green"
                    android:layout_marginEnd="16dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gestión de Préstamos"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_900" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cobros, moras y cronogramas"
                        android:textSize="14sp"
                        android:textColor="@color/slate_500" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHotel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="🏨"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_light_blue"
                    android:layout_marginEnd="16dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gestión de Hotel"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_900" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Habitaciones y reservaciones"
                        android:textSize="14sp"
                        android:textColor="@color/slate_500" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackSelection"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Atrás"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmSelection"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Continuar"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/purple_600" />

</LinearLayout>
