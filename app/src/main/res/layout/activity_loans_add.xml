<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:elevation="0dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarAddLoan"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Registrar Préstamo"
                app:navigationIcon="@android:drawable/ic_menu_revert" />

            <ImageButton
                android:id="@+id/btnSyncIndicator"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/stat_sys_download_done"
                android:contentDescription="Estado de sincronización"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="200dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- SECCIÓN 1: DATOS BÁSICOS (LO QUE TODOS LLENAN) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información del Préstamo"
                        android:textStyle="bold"
                        android:textColor="@color/purple_600"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="¿A quién le prestas? (Nombre)"
                        app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                        app:endIconMode="clear_text"
                        android:layout_marginBottom="6dp">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/etLoanClientName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickContact"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:text="👥 Elegir de Contactos"
                        android:textSize="12sp"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="¿Cuánto das?"
                            app:prefixText="S/ "
                            app:endIconMode="clear_text"
                            android:layout_marginEnd="8dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLoanAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:hint="Interés"
                            app:suffixText="%"
                            app:endIconMode="clear_text">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLoanInterest"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="20"
                                android:textStyle="bold"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Número de celular (Opcional)"
                        app:startIconDrawable="@android:drawable/ic_menu_call"
                        app:endIconMode="clear_text"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLoanClientPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- FOTO DEL CLIENTE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardClientPhotoPreview"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardCornerRadius="26dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/purple_50"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/purple_200"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:id="@+id/ivClientPhotoPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="@color/purple_600" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Foto del Cliente (Opcional)"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Toma foto para identificar al cliente"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCaptureClientPhoto"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="📸 Tomar Foto"
                            android:textSize="11sp"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN: ORIGEN DEL DINERO (PRESUPUESTO VS PERSONAL) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿De dónde sale el dinero del préstamo?"
                        android:textStyle="bold"
                        android:textColor="@color/slate_600"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleFundingSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@id/btnFundingBudget">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFundingBudget"
                            style="@style/Widget.App.Button.Toggle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💼 Negocio (Presupuesto)"
                            android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFundingPersonal"
                            style="@style/Widget.App.Button.Toggle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👤 Bolsillo Personal"
                            android:textSize="11sp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- CUENTAS VINCULADAS AL ORIGEN SELECCIONADO -->
                    <TextView
                        android:id="@+id/tvLinkedAccountsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cuentas vinculadas a este origen:"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/layoutAccountChipsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvAvailableFundsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo disponible en cuentas seleccionadas: S/ 0.00"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/emerald_600" />

                    <TextView
                        android:id="@+id/tvFundsWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Fondos insuficientes en la(s) cuenta(s) seleccionada(s). Selecciona más cuentas o ajusta el saldo."
                        android:textSize="12sp"
                        android:textColor="@color/red_600"
                        android:visibility="gone"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN 1.5: FECHA DE COBRO (OPCIONAL Y INDEPENDIENTE) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- FECHA DEL PRÉSTAMO (SIEMPRE VISIBLE - HOY POR DEFECTO) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha del Préstamo"
                        android:textStyle="bold"
                        android:textColor="@color/slate_600"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLoanStartDatePicker"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="📅 Fecha del Préstamo: Hoy"
                        android:gravity="start|center_vertical"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="16dp"
                        app:cornerRadius="14dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <!-- FECHA DE COBRO DE LA CUOTA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fecha Límite de Cobro"
                            android:textStyle="bold"
                            android:textColor="@color/slate_600"
                            android:textSize="13sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchEnableDueDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLoanDatePicker"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="📅 Seleccionar fecha de cobro"
                        android:visibility="gone"
                        app:cornerRadius="14dp"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN 2: PLAN DE PAGO Y CUOTAS (OPCIONAL) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Plan de Pago / Cuotas"
                            android:textStyle="bold"
                            android:textColor="@color/slate_600"
                            android:textSize="14sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchEnablePaymentPlan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutPaymentPlanOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleLoanFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:checkedButton="@id/btnFreqDaily"
                            android:layout_marginBottom="12dp">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFreqNone"
                                style="@style/Widget.App.Button.Toggle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Única"
                                android:paddingLeft="4dp"
                                android:paddingRight="4dp"
                                android:textSize="11sp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFreqDaily"
                                style="@style/Widget.App.Button.Toggle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Diario"
                                android:paddingLeft="4dp"
                                android:paddingRight="4dp"
                                android:textSize="11sp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFreqWeekly"
                                style="@style/Widget.App.Button.Toggle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Semanal"
                                android:paddingLeft="4dp"
                                android:paddingRight="4dp"
                                android:textSize="11sp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFreqMonthly"
                                style="@style/Widget.App.Button.Toggle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mensual"
                                android:paddingLeft="4dp"
                                android:paddingRight="4dp"
                                android:textSize="11sp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <LinearLayout
                            android:id="@+id/layoutInstallmentConfig"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Número de cuotas a pagar">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etLoanInstallments"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="24"
                                    android:imeOptions="actionDone" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN 3: DETALLES ADICIONALES (FOTOS, DNI, GARANTÍA) - ACTIVABLE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Más detalles (Fotos, DNI, Garantía)"
                            android:textStyle="bold"
                            android:textColor="@color/slate_600"
                            android:textSize="14sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchEnableAdvancedOptions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <!-- OPCIONES AVANZADAS (OCULTAS POR DEFECTO) -->
                    <LinearLayout
                        android:id="@+id/layoutAdvancedOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:strokeWidth="0dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Seguridad y Documentos"
                                    android:textStyle="bold"
                                    android:textColor="@color/slate_600"
                                    android:textSize="13sp"
                                    android:layout_marginBottom="12dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="12dp">
                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnCaptureDocPhoto"
                                        style="@style/Widget.Material3.Button.TonalButton"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="🆔 Foto DNI"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="DNI / RUC del cliente"
                                    app:endIconMode="clear_text"
                                    android:layout_marginBottom="12dp">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etLoanClientDoc"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:imeOptions="actionNext" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilLoanClientAddress"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Dirección o referencia"
                                    app:startIconDrawable="@android:drawable/ic_menu_mylocation"
                                    app:endIconMode="clear_text">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etLoanClientAddress"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textPostalAddress"
                                        android:imeOptions="actionNext" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:strokeWidth="0dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mora y Garantía"
                                    android:textStyle="bold"
                                    android:textColor="@color/slate_600"
                                    android:textSize="13sp"
                                    android:layout_marginBottom="12dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <com.google.android.material.textfield.TextInputLayout
                                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:hint="Mora Diaria"
                                        app:prefixText="S/ "
                                        android:layout_marginEnd="8dp">
                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/etLoanLateFee"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:inputType="numberDecimal"
                                            android:text="0"
                                            android:imeOptions="actionNext" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                    <com.google.android.material.textfield.TextInputLayout
                                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:hint="Días Gracia">
                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/etLoanGraceDays"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:inputType="number"
                                            android:text="0"
                                            android:imeOptions="actionNext" />
                                    </com.google.android.material.textfield.TextInputLayout>
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCaptureCollateralPhoto"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="📷 Tomar foto a la Garantía (Prenda)"
                                    android:textSize="11sp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="¿Qué te dejó como garantía?">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etLoanCollateralDesc"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textCapSentences"
                                        android:imeOptions="actionDone" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbSkipSundays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Omitir Domingos en el cronograma"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="140dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FOOTER FIJO: CÁLCULOS Y BOTÓN DE GUARDADO -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- RESUMEN DE CÁLCULO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoanCalculationSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorPrimary">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/tvLoanCalculatedQuota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cuota: S/ 0.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />
                    <TextView
                        android:id="@+id/tvLoanCalculatedTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total a devolver: S/ 0.00"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="1dp" />
                    <TextView
                        android:id="@+id/tvLoanCalculatedDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Préstamo directo (Sin fecha ni cuotas)"
                        android:textSize="11sp"
                        android:textColor="@color/slate_500"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveLoan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="GUARDAR PRÉSTAMO"
                android:textStyle="bold"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/emerald_600" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>