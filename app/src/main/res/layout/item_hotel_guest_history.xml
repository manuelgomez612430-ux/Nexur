<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvGuestName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Huésped"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/chipNationality"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNationality"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Nacional"
                android:textSize="10sp"
                app:chipMinHeight="24dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvGuestDoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DNI: 12345678"
            android:textSize="13sp"
            android:textColor="@color/slate_500" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginVertical="12dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins">

            <!-- Fila 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HABITACIÓN"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400" />
                <TextView
                    android:id="@+id/tvRoomNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Piso 1 - Hab 101"
                    android:textSize="13sp"
                    android:textColor="@color/slate_800" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTANCIA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400" />
                <TextView
                    android:id="@+id/tvStayDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 Noches"
                    android:textSize="13sp"
                    android:textColor="@color/slate_800" />
            </LinearLayout>

            <!-- Fila 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROCEDENCIA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400" />
                <TextView
                    android:id="@+id/tvOrigin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lima, Perú"
                    android:textSize="13sp"
                    android:textColor="@color/slate_800" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONSUMO EXTRA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400" />
                <TextView
                    android:id="@+id/tvExtraCharges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 0.00"
                    android:textSize="13sp"
                    android:textColor="@color/red_600" />
            </LinearLayout>
        </GridLayout>

        <!-- Fila Final Destacada: PAGO TOTAL -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_50"
            android:layout_marginVertical="12dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAGO TOTAL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/slate_600"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="S/ 0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/emerald_600" />
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
