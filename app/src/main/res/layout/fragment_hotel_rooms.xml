<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/roomsContentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeftRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.06" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRightRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.94" />

    <!-- FONDO DE CABECERA PREMIUM (Ajustado a la mitad del botón) -->
    <View
        android:id="@+id/roomsHeaderBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/purple_600"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/cardToggleContainer"
        android:layout_marginBottom="26dp" />

    <!-- TOOLBAR CUSTOM -->
    <LinearLayout
        android:id="@+id/layoutRoomsToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/guidelineRightRoot"
        app:layout_constraintStart_toStartOf="@id/guidelineLeftRoot"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnMenuRooms"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Gestión de Habitaciones"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnBulkDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- SELECTOR DE VISTA (PILL FLOTANTE) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardToggleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutRoomsToolbar"
        app:strokeWidth="0dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleViewMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            app:checkedButton="@id/btnListView"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnListView"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="24dp"
                android:text="Lista"
                android:textColor="@color/toggle_text_color"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/toggle_background_color"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconSize="20dp"
                app:iconTint="@color/toggle_text_color"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGraphView"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="24dp"
                android:text="Mapa"
                android:textColor="@color/toggle_text_color"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/toggle_background_color"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconSize="20dp"
                app:iconTint="@color/toggle_text_color"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Pill" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- LIST VIEW CONTAINER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:paddingBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roomsHeaderBackground"
        tools:listitem="@layout/item_hotel_room" />

    <!-- GRAPH VIEW CONTAINER (MAPA) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutGraphView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardToggleContainer">

        <!-- FLOOR SELECTOR -->
        <HorizontalScrollView
            android:id="@+id/scrollFloors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/layoutFloors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp" />
        </HorizontalScrollView>

        <!-- MAPA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapDisplay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toTopOf="@id/btnOpenEditor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollFloors"
            app:strokeWidth="1dp"
            app:strokeColor="@color/slate_100">

            <com.gomezmart.app.util.HotelMapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

        <!-- EMPTY STATE MAP -->
        <LinearLayout
            android:id="@+id/layoutEmptyMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/cardMapDisplay"
            app:layout_constraintEnd_toEndOf="@id/cardMapDisplay"
            app:layout_constraintStart_toStartOf="@id/cardMapDisplay"
            app:layout_constraintTop_toTopOf="@id/cardMapDisplay">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Piso sin diseño"
                android:textColor="@color/slate_400"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateMapEmpty"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Crear mapa"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenEditor"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="32dp"
            android:text="Editar Pisos"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_menu_edit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FAB PREMIUM -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddRoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Nueva Habitación"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/purple_600"
        app:cornerRadius="28dp"
        app:elevation="12dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
