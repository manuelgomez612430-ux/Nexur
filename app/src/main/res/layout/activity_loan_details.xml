<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:elevation="0dp"
        app:liftOnScroll="false">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarLoanDetails"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Detalle del Préstamo"
                app:navigationIcon="@android:drawable/ic_menu_revert" />

            <ImageButton
                android:id="@+id/btnDeleteClient"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Eliminar cliente"
                app:tint="@color/red_600" />

            <ImageButton
                android:id="@+id/btnSyncIndicator"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/stat_sys_download_done"
                android:contentDescription="Estado de sincronización"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <!-- INFORMACIÓN DEL CLIENTE REFINADA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailClientName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nombre Cliente"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvDetailClientAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Dirección del domicilio"
                                android:textSize="13sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:layout_marginTop="2dp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnEditClientInfo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_edit"
                                app:tint="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailLoanAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Deuda Total: S/ 0.00"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- SALDO PENDIENTE PROMINENTE -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPendingBalanceContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/emerald_50"
                        app:strokeWidth="1dp"
                        app:strokeColor="#D1FAE5">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvPendingBalanceLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SALDO RESTANTE"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/emerald_600"
                                android:letterSpacing="0.1" />
                            <TextView
                                android:id="@+id/tvDetailPendingBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S/ 0.00"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:textColor="@color/emerald_700" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ACCIONES RÁPIDAS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCallClient"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:text="Llamar"
                            android:layout_marginEnd="6dp"
                            app:cornerRadius="16dp"
                            app:icon="@android:drawable/ic_menu_call"
                            app:backgroundTint="?attr/colorSurfaceContainerHigh"
                            android:textColor="?attr/colorPrimary"
                            app:iconTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIncreaseDebt"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1.2"
                            android:text="Sumar Deuda"
                            android:layout_marginStart="6dp"
                            app:cornerRadius="16dp"
                            app:icon="@android:drawable/ic_input_add"
                            app:backgroundTint="?attr/colorPrimaryContainer"
                            android:textColor="?attr/colorPrimary"
                            app:iconTint="?attr/colorPrimary" />
                    </LinearLayout>

                    <!-- OPERACIONES FINANCIERAS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GESTIÓN Y OPERACIONES"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_400"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLiquidateLoan"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Liquidar Todo el Préstamo"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/emerald_50"
                        android:textColor="@color/emerald_700"
                        app:icon="@android:drawable/checkbox_on_background"
                        app:iconTint="@color/emerald_700" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefinanceLoan"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:text="Refinanciar Deuda Actual"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/orange_50"
                        android:textColor="@color/orange_600"
                        app:icon="@android:drawable/ic_menu_rotate"
                        app:iconTint="@color/orange_600" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/slate_100"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShareLoanContract"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Generar PDF"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:icon="@android:drawable/ic_menu_share"
                            app:iconTint="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditLoanTerms"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Plan de Pago"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:icon="@android:drawable/ic_menu_manage"
                            app:iconTint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvLabelInstallments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRONOGRAMA DE PAGOS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/slate_400"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInstallments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- SECCIÓN DE GARANTÍA -->
            <TextView
                android:id="@+id/tvLabelCollateral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GARANTÍA REGISTRADA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/slate_400"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCollateralDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/slate_100"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <ImageView
                        android:id="@+id/ivCollateralPreview"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:layout_marginBottom="12dp" />
                    <TextView
                        android:id="@+id/tvCollateralDescDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descripción de la prenda..."
                        android:textColor="@color/slate_600"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTÓN PAGO FLOTANTE / FIJO (SIEMPRE VISIBLE) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuickPayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardElevation="12dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="?attr/colorSurface"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickPaySingle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_margin="20dp"
            android:text="REGISTRAR PAGO"
            android:textStyle="bold"
            android:textSize="16sp"
            app:cornerRadius="20dp"
            app:backgroundTint="@color/emerald_600" />
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
