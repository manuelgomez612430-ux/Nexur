<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de indicador clave: etiqueta a la izquierda, valor a la derecha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="11dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tvIndicatorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Margen de ganancia"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/slate_900" />

        <TextView
            android:id="@+id/tvIndicatorSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Sobre lo cobrado"
            android:textSize="11sp"
            android:textColor="@color/slate_500" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/slate_100"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tvIndicatorValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="0 %"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/slate_900" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
