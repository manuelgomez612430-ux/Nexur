<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del desglose: punto de color + nombre + descripción + monto + porcentaje -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp">

    <View
        android:id="@+id/viewColorDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/indigo_500" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capital prestado"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/slate_900" />

        <TextView
            android:id="@+id/tvRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Dinero que está en la calle"
            android:textSize="11sp"
            android:textColor="@color/slate_500" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvRowAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/ 0.00"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/slate_900" />

        <TextView
            android:id="@+id/tvRowPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="0 %"
            android:textSize="11sp"
            android:textColor="@color/slate_500" />
    </LinearLayout>
</LinearLayout>
