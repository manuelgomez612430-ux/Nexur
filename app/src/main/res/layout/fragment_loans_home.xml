<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">
        <FrameLayout
            android:id="@+id/headerLoansHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarLoansHome"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:contentInsetStart="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnProfileLoans"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/ivProfileLoans"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/gomezmart_icon" />
                </com.google.android.material.card.MaterialCardView>

                <!-- BLOQUE CENTRADO: nombre del usuario + bajada -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvHeaderUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usuario"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_900"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sistema de préstamos"
                        android:textSize="9sp"
                        android:textColor="@color/purple_600"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- BANDERITA DE REPORTAR (a la derecha del todo) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportErrorLoans"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="Reportar un error o sugerencia"
                    app:icon="@drawable/ic_flag_report"
                    app:iconSize="20dp"
                    app:iconTint="@color/purple_700"
                    app:backgroundTint="@color/purple_50"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/purple_200"
                    app:cornerRadius="19dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- RESUMEN DE DINERO (DESPLEGABLE INDEPENDIENTE / CONFIDENCIAL) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBusinessSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/headerSummaryCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Resumen de mi negocio"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvToggleSummaryIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="👁️ Ver"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutSummaryContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginBottom="14dp" />

                        <!-- FILA 1: DINERO PRESTADO -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_bottom_sheet_rounded"
                            android:backgroundTint="?attr/colorSurfaceContainer"
                            android:padding="14dp"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="💰 Dinero prestado total"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />
                                <TextView
                                    android:id="@+id/tvStatCapitalLent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="S/ 0.00"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorPrimary" />
                            </LinearLayout>

                            <!-- Sub-desglose: Presupuesto y Personal -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:background="@drawable/bg_bottom_sheet_rounded"
                                android:backgroundTint="?attr/colorSurfaceContainerHigh"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:gravity="center_vertical">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="💼 Presupuesto"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/slate_500" />
                                    <TextView
                                        android:id="@+id/tvStatCapitalLentBusiness"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="S/ 0.00"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="24dp"
                                    android:background="?attr/colorOutlineVariant"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginEnd="10dp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="👤 Personal"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/slate_500" />
                                    <TextView
                                        android:id="@+id/tvStatCapitalLentPersonal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="S/ 0.00"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- FILA 2: SALDO POR COBRAR -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_bottom_sheet_rounded"
                            android:backgroundTint="?attr/colorSurfaceContainer"
                            android:padding="14dp"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="💸 Saldo por cobrar"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/tvStatOutstandingBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S/ 0.00"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/sky_600" />
                        </LinearLayout>

                        <!-- FILA 3: GANANCIA ESTIMADA -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_bottom_sheet_rounded"
                            android:backgroundTint="?attr/colorSurfaceContainer"
                            android:padding="14dp"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📊 Ganancia Estimada"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/tvStatEstimatedProfit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S/ 0.00"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/purple_600" />
                        </LinearLayout>

                        <!-- FILA 4: GANANCIA OBTENIDA -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_bottom_sheet_rounded"
                            android:backgroundTint="?attr/colorSurfaceContainer"
                            android:padding="14dp"
                            android:layout_marginBottom="14dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📈 Ganancia Obtenida"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:id="@+id/tvStatNetProfit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S/ 0.00"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="@color/emerald_600" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExplainSummary"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:text="ℹ️ Entender estas métricas"
                            android:textSize="12sp"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD DE PRESUPUESTO (DESPLEGABLE INDEPENDIENTE / CONFIDENCIAL) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoanBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/headerBudgetCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tvBudgetTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Presupuesto Mensual"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvToggleBudgetIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="6dp"
                            android:text="👁️ Ver"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutBudgetContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvBudgetRemaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S/ 0.00 disponibles"
                            android:textColor="@color/emerald_600"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressBudget"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:progress="0"
                            app:indicatorColor="@color/emerald_600"
                            app:trackColor="@color/slate_100"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:id="@+id/tvBudgetDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Has usado S/ 0 de tu presupuesto total"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfigBudget"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:text="⚙️ Ajuste de Capital Operativo"
                            app:cornerRadius="12dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACCIONES RÁPIDAS (NUEVO PRESTAMO / REGISTRAR GASTO) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickNewLoan"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Nuevo Préstamo o Deudor"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    app:cornerRadius="20dp"
                    app:icon="@android:drawable/ic_input_add"
                    app:backgroundTint="@color/emerald_50"
                    android:textColor="@color/emerald_700"
                    app:iconTint="@color/emerald_700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickRegisterExpense"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Registrar Gasto"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    app:cornerRadius="20dp"
                    app:icon="@android:drawable/ic_menu_send"
                    app:backgroundTint="#FEE2E2"
                    android:textColor="@color/red_700"
                    app:iconTint="@color/red_700" />
            </LinearLayout>

            <!-- BOTÓN GIGANTE: COBRAR HOY -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodayCollections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/purple_600"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="@color/white" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿A quién cobramos hoy?"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/white" />
                        <TextView
                            android:id="@+id/tvCollectionsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toca aquí para ver tu lista"
                            android:textSize="15sp"
                            android:textColor="#D0FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HERRAMIENTAS EN LÍNEA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTORIAL Y REPORTES"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <!-- FILA 1 DE ACCESOS DIRECTOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- 1. MIS CLIENTES -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLoansClients"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#EEF2FF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#C7D2FE"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👥"
                            android:textSize="36sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MIS CLIENTES"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="#312E81"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. MIS GASTOS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLoansExpenses"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFF1F2"
                    app:strokeWidth="1dp"
                    app:strokeColor="#FECDD3"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💸"
                            android:textSize="36sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MIS GASTOS"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="#881337"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. MIS COMPROMISOS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLoansCommitments"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F3E8FF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E9D5FF"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅"
                            android:textSize="36sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMPROMISOS"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="#581C87"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SEGUNDA FILA DE ACCESOS DIRECTOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:weightSum="3">

                <!-- 4. ASESOR IA -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLoansAiChat"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FAF5FF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F3E8FF"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🤖"
                            android:textSize="36sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ASESOR IA"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="#3B0764"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. BUZÓN / MENSAJES -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLoansMailbox"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#EFF6FF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BFDBFE"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📬"
                            android:textSize="36sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BUZÓN"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="#0C4A6E"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. HISTORIAL DE MOVIMIENTOS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLoansMovements"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#ECFDF5"
                    app:strokeWidth="1dp"
                    app:strokeColor="#A7F3D0"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊"
                            android:textSize="36sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOVIMIENTOS"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="#064E3B"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- TERCERA FILA DE ACCESOS DIRECTOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:weightSum="3">

                <!-- 7. MIS CUENTAS Y DINERO -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLoansAccounts"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F5F3FF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#DDD6FE"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏦"
                            android:textSize="36sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CUENTAS"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="#5B21B6"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Espacios vacíos para mantener alineación de 3 columnas -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <!-- BOTÓN APOYAR AL CREADOR (MUY DISCRETO) -->
            <LinearLayout
                android:id="@+id/btnSupportCreatorHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.8">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/emerald_600" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Presiona aquí para apoyar al creador"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ayúdame a mantener GoMezMart gratuito y sin anuncios"
                        android:textSize="9sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <!-- FOOTER INFO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GoMezMart Préstamos v1.5.40"
                android:textAlignment="center"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>