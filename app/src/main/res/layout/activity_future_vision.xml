<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarVision"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Visión y Sostenibilidad"
            app:titleTextColor="@color/slate_900"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/slate_900" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- SECCIÓN 1: MISIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Misión 🛡️"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/purple_800" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Naxor nació con un objetivo claro: empoderar a los pequeños y grandes negocios ofreciendo herramientas profesionales de gestión de forma gratuita y accesible para todos. Quiero crecer junto a tu negocio."
                android:textSize="15sp"
                android:textColor="@color/slate_700"
                android:lineSpacingExtra="4dp" />

            <!-- SECCIÓN 2: EL COMPROMISO SIN ANUNCIOS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/emerald_50"
                app:strokeWidth="1dp"
                app:strokeColor="@color/emerald_600">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="@color/emerald_600" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Promesa Naxor: Nunca permitiré anuncios en el sistema. Tu enfoque debe estar en tu negocio, no en publicidad molesta."
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/emerald_700" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN 3: EL DESAFÍO DE LA SOSTENIBILIDAD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Seguridad y Calidad 💎"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Para garantizar una SEGURIDAD ABSOLUTA de tus datos, una infraestructura 100% estable y servicios de primera calidad, se requiere de una inversión constante. Actualmente, el proyecto es desarrollado y financiado íntegramente por su creador."
                android:textSize="15sp"
                android:textColor="@color/slate_600"
                android:lineSpacingExtra="4dp" />

            <!-- SECCIÓN 4: EL PLAN B -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="¿Por qué donar? 🤝"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tu generosidad es mi incentivo. Si el apoyo de la comunidad a través de donaciones voluntarias crece y se mantiene, Naxor podrá seguir siendo gratuito para todos por mucho más tiempo.\n\nSolo en caso de que las donaciones no sean suficientes para mantener el proyecto sostenible y seguro, me veré obligado a recurrir al 'Plan B': integrar planes de suscripción con costos muy accesibles para contratar ayuda especializada dedicada al soporte y optimización constante."
                android:textSize="15sp"
                android:textColor="@color/slate_600"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Cada granito de arena cuenta. Tu aporte voluntario me motiva a seguir construyendo la mejor herramienta para tu negocio. ❤️"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@color/purple_600" />

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
