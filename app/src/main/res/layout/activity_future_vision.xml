<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarVision"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarVision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:title="Visión y Sostenibilidad"
            app:titleTextColor="@color/slate_900"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/slate_900" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- SECCIÓN 1: MISIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Misión 🛡️"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/purple_800" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="GoMezMart tiene una misión clara: ser tu aliado tecnológico. No buscamos ser solo una app, sino una herramienta potente, intuitiva y accesible que te dé el control total de tu negocio sin complicaciones técnicas, creciendo junto a ti."
                android:textSize="15sp"
                android:textColor="@color/slate_700"
                android:lineSpacingExtra="4dp" />

            <!-- SECCIÓN 2: EL COMPROMISO SIN ANUNCIOS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/emerald_50"
                app:strokeWidth="1dp"
                app:strokeColor="@color/emerald_600">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="@color/emerald_600" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Promesa GoMezMart: Nunca permitiré anuncios en el sistema. Tu enfoque debe estar en tu negocio, no en publicidad molesta."
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/emerald_700" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN 3: EL DESAFÍO DE LA SOSTENIBILIDAD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Seguridad y Confianza 💎"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Entiendo que tu información es lo más valioso. Por eso, GoMezMart es un sistema 100% seguro y blindado. Aunque como todo software puede tener pequeños errores en los que trabajo incansablemente para corregir, mi compromiso es ofrecerte una infraestructura robusta y estable de primera calidad.\n\nMantener este nivel de seguridad y estar a la vanguardia tecnológica requiere una inversión constante de tiempo y recursos, los cuales hoy asumo personalmente."
                android:textSize="15sp"
                android:textColor="@color/slate_600"
                android:lineSpacingExtra="4dp" />

            <!-- SECCIÓN 4: POR QUÉ LAS DONACIONES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="¿Por qué donar? 🤝"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Las donaciones son el motor que permite que GoMezMart siga siendo gratuito en su gran mayoría. Tu aporte ayuda a cubrir los costos de servidores y compensa el tiempo dedicado a crear nuevas funciones de alta calidad que otros bloquean tras pagos excesivos.\n\nEs un incentivo para que este proyecto siga vivo, se mantenga actualizado frente a la competencia y siempre esté a tu servicio."
                android:textSize="15sp"
                android:textColor="@color/slate_600"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Cada granito de arena cuenta. Tu aporte voluntario me motiva a seguir construyendo la mejor herramienta para tu negocio. ❤️"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@color/purple_600" />

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
