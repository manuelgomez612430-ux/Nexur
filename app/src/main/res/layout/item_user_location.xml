<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLocationItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/slate_200"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLocationEmoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="📍"
            android:textSize="22sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_surface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLocationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi Ubicación"
                    android:textColor="@color/slate_900"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDefaultBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_purple_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="PRINCIPAL ⭐"
                    android:textColor="@color/purple_700"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLocationAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dirección"
                android:textColor="@color/slate_500"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLocationReference"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ref:"
                android:textColor="@color/purple_600"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Botón a la derecha para establecer Prioridad / Principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetPriority"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:text="Prioridad 📌"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/purple_700"
            app:backgroundTint="@color/purple_50"
            app:cornerRadius="12dp"
            android:paddingHorizontal="10dp" />

        <ImageButton
            android:id="@+id/btnDeleteLocation"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/red_600" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>