<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/slate_50"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/ivRoomIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="@color/purple_600" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvRoomNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habitación 101"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900" />
                <TextView
                    android:id="@+id/tvRoomType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simple"
                    android:textSize="13sp"
                    android:textColor="@color/slate_500" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoomStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIBRE"
                app:chipBackgroundColor="@color/emerald_50"
                app:chipStrokeWidth="0dp"
                android:textColor="@color/emerald_600"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginVertical="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARIFA DIARIA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400"
                    android:letterSpacing="0.05" />
                <TextView
                    android:id="@+id/tvRoomPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 80.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple_800" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThirdAction"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reparado"
                android:visibility="gone"
                app:cornerRadius="12dp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp"
                app:backgroundTint="@color/slate_100"
                android:textColor="@color/sky_600" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecondAction"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aseado"
                android:visibility="gone"
                app:cornerRadius="12dp"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                app:backgroundTint="@color/orange_50"
                android:textColor="@color/orange_600" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoomAction"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check-in"
                app:cornerRadius="12dp"
                android:paddingHorizontal="20dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
