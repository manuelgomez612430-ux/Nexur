<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_100"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ICONO DINÁMICO TIPO BURBUJA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/slate_50">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/tvRoomEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🏨"
                        android:textSize="24sp" />
                    <ImageView
                        android:id="@+id/ivRoomIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="@color/purple_600"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                <TextView
                    android:id="@+id/tvRoomNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habitación 101"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900" />
                <TextView
                    android:id="@+id/tvRoomType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simple"
                    android:textSize="13sp"
                    android:textColor="@color/slate_400" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoomStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIBRE"
                app:chipBackgroundColor="@color/emerald_50"
                app:chipStrokeWidth="0dp"
                android:textColor="@color/emerald_600"
                android:textSize="10sp"
                android:textStyle="bold"
                app:chipMinTouchTargetSize="0dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_50"
            android:layout_marginVertical="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARIFA DIARIA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400"
                    android:letterSpacing="0.05" />
                <TextView
                    android:id="@+id/tvRoomPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 0.00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple_700" />
            </LinearLayout>

            <!-- CONTENEDOR DE ACCIONES DINÁMICAS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnThirdAction"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Reparado"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp"
                    app:backgroundTint="@color/slate_50"
                    android:textColor="@color/sky_600"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecondAction"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Aseado"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    app:backgroundTint="@color/orange_50"
                    android:textColor="@color/orange_600"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoomAction"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Check-in"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/purple_600"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconSize="16dp"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
