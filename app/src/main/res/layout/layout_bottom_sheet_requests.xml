<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_top_rounded_white"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@color/slate_200"
        android:backgroundTint="@color/slate_200" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Solicitudes de Equipo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/slate_900" />

        <TextView
            android:id="@+id/tvRequestsTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 pendientes"
            android:textColor="@color/purple_600"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRequestsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="500dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvEmptyRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No tienes solicitudes nuevas por el momento."
        android:textAlignment="center"
        android:padding="40dp"
        android:textColor="@color/slate_400"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
