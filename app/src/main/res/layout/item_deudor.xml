<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDeudor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PARTE SUPERIOR: INFORMACIÓN -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Avatar / Inicial -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1F5F9">
                <TextView
                    android:id="@+id/tvDeudorInicial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple_600" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/cardAvatar"
                android:layout_toStartOf="@+id/layoutMontoItem"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeudorNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Cliente"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900" />

                <TextView
                    android:id="@+id/tvDeudorTelefono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="999 999 999"
                    android:textSize="13sp"
                    android:textColor="@color/slate_500" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="4dp">
                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="AL DÍA"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Monto resaltado -->
            <LinearLayout
                android:id="@+id/layoutMontoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvDeudorMonto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 0.00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900" />
                <TextView
                    android:id="@+id/tvFechaCobro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vence: Hoy"
                    android:textSize="11sp"
                    android:textColor="@color/slate_400" />
            </LinearLayout>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginHorizontal="16dp" />

        <!-- BARRA DE ACCIONES INFERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnEditDebtor"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/slate_400"
                android:contentDescription="Editar" />

            <ImageButton
                android:id="@+id/btnGeneratePdf"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/slate_400"
                android:contentDescription="PDF" />

            <ImageButton
                android:id="@+id/btnCobrarWhatsApp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/green_600"
                android:contentDescription="WhatsApp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPagarDeuda"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pagar"
                android:textSize="11sp"
                android:textColor="@color/green_600"
                app:icon="@android:drawable/checkbox_on_background"
                app:iconSize="14dp"
                app:iconTint="@color/green_600" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAumentarDeuda"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Fiar (+)"
                android:textSize="11sp"
                android:textColor="@color/purple_600" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
