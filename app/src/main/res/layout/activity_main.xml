<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <!-- GUÍAS PORCENTUALES (Aseguran simetría en cualquier ancho) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.06" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.94" />

        <!-- BOTÓN MENÚ -->
        <ImageButton
            android:id="@+id/btnOpenMenuMain"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_surface"
            android:src="@android:drawable/ic_menu_more"
            app:layout_constraintEnd_toEndOf="@id/guidelineRight"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Opciones" />

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="@id/guidelineLeft"
            app:layout_constraintEnd_toStartOf="@id/btnOpenMenuMain"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/logo_naxor_icon"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvMainBusinessName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mi Negocio"
                android:textSize="18sp"
                android:textStyle="bold"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="18sp"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- DASHBOARD (VENTAS Y UTILIDAD) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="@id/guidelineLeft"
            app:layout_constraintEnd_toEndOf="@id/guidelineRight"
            app:layout_constraintTop_toBottomOf="@id/headerTitle">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/labelVentas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ventas hoy"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvVentasHoyMain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="S/ 0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeMaxTextSize="22sp"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:layout_constraintTop_toBottomOf="@id/labelVentas"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/barrierCenter"/>

                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/barrierCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="left"
                    app:constraint_referenced_ids="labelUtilidad,tvUtilidadHoyMain" />

                <TextView
                    android:id="@+id/labelUtilidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Utilidad"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tvUtilidadHoyMain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="S/ 0.00"
                    android:textSize="22sp"
                    android:gravity="end"
                    android:textStyle="bold"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeMaxTextSize="22sp"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:layout_constraintTop_toBottomOf="@id/labelUtilidad"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvVentasHoyMain"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FILA DINÁMICA: INVENTARIO Y GASTOS (Uso de pesos en ConstraintLayout) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainInventario"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="6dp"
            android:text="📦 INVENTARIO"
            android:textSize="14sp"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="14sp"
            android:textColor="@android:color/white"
            app:backgroundTint="#8E44AD"
            app:cornerRadius="20dp"
            app:layout_constraintTop_toBottomOf="@id/cardDashboard"
            app:layout_constraintStart_toStartOf="@id/guidelineLeft"
            app:layout_constraintEnd_toStartOf="@+id/btnMainGastos"
            app:layout_constraintHorizontal_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainGastos"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="6dp"
            android:text="💸 GASTOS"
            android:textSize="14sp"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="14sp"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/red_600"
            app:cornerRadius="20dp"
            app:layout_constraintTop_toBottomOf="@id/cardDashboard"
            app:layout_constraintStart_toEndOf="@id/btnMainInventario"
            app:layout_constraintEnd_toEndOf="@id/guidelineRight"
            app:layout_constraintHorizontal_weight="1" />

        <!-- BOTÓN HISTORIAL DE MOVIMIENTOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainHistory"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="📜 HISTORIAL DE MOVIMIENTOS"
            android:textSize="13sp"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="13sp"
            app:cornerRadius="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnMainInventario"
            app:layout_constraintStart_toStartOf="@id/guidelineLeft"
            app:layout_constraintEnd_toEndOf="@id/guidelineRight" />

        <!-- MÁS OPCIONES EXPANDIDO -->
        <LinearLayout
            android:id="@+id/layoutMoreOptionsExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/btnMainMoreOptions"
            app:layout_constraintStart_toStartOf="@id/guidelineLeft">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMainCatalogo"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="160dp"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="📖 Catálogo"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/sky_600"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMainAjustes"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="160dp"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="⚙️ Ajustes"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/slate_600"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMainSync"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="160dp"
                android:layout_height="56dp"
                android:text="🔄 Sincronizar"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/emerald_600"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnMainMoreOptions"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#8E44AD"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toTopOf="@id/btnIrVentas"
            app:layout_constraintStart_toStartOf="@id/guidelineLeft">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/arrow_up_float"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÓN REALIZAR VENTA (Adaptativo) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrVentas"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:text="REALIZAR VENTA"
            android:textSize="18sp"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeMaxTextSize="18sp"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/emerald_600"
            app:icon="@android:drawable/ic_menu_add"
            app:iconTint="@android:color/white"
            app:iconSize="32dp"
            app:cornerRadius="24dp"
            app:layout_constraintStart_toStartOf="@id/guidelineLeft"
            app:layout_constraintEnd_toEndOf="@id/guidelineRight"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationViewMain"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:menu="@menu/menu_main_drawer"
        app:headerLayout="@layout/drawer_header_simple" />

</androidx.drawerlayout.widget.DrawerLayout>
