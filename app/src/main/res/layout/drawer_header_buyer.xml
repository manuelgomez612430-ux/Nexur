<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/purple_600"
    android:padding="24dp"
    android:gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">
        <ImageView
            android:id="@+id/ivBuyerDrawerLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/logotipo_de_gomezmart"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvBuyerDrawerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nombre del Comprador"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvBuyerDrawerEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="comprador@correo.com"
        android:textColor="@color/white"
        android:alpha="0.8"
        android:textSize="13sp"
        android:gravity="center" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="0dp">
        <TextView
            android:id="@+id/tvBuyerRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒 COMPRADOR"
            android:textColor="@color/purple_600"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
