<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvBookingRoomName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre de Habitación"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDIENTE"
                android:textSize="10sp"
                app:chipCornerRadius="8dp"
                app:chipBackgroundColor="@color/orange_50"
                app:chipStrokeWidth="0dp"
                android:textColor="@color/orange_600" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBookingStay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estadía: 2 noches"
            android:textSize="14sp"
            android:textColor="@color/slate_600"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvBookingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha: 01/01/2024"
            android:textSize="13sp"
            android:textColor="@color/slate_500"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
