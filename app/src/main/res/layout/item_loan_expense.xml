<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1AEE4435">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/red_600" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            <TextView
                android:id="@+id/tvLoanExpenseCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Combustible"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05"
                android:layout_marginBottom="2dp" />
            <TextView
                android:id="@+id/tvLoanExpenseConcept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gasolina"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface" />
            <TextView
                android:id="@+id/tvLoanExpenseDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26/08/2026 18:00"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLoanExpenseAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- S/ 20.00"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/red_600" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
