<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarMarketplace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gomezmart_primary"
        android:fitsSystemWindows="false"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/gomezmart_primary">

            <!-- 1. BARRA SUPERIOR: MENU, BÚSQUEDA Y FAVORITOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnOpenMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/white" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="12dp"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="@color/slate_400" />

                        <EditText
                            android:id="@+id/etSearchMarketplace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="Buscar en GoMezMart"
                            android:paddingHorizontal="8dp"
                            android:textSize="14sp"
                            android:textColor="@color/slate_900"
                            android:inputType="text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnFavorites"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#20FFFFFF"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⭐"
                        android:textSize="20sp"
                        android:includeFontPadding="false" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 2. BARRA DE UBICACIÓN (EMOJI + CIUDAD Y CÓDIGO POSTAL + BOTÓN CAMBIAR AL COSTADO) -->
            <LinearLayout
                android:id="@+id/btnLocationSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvLocationEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="15sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvCurrentLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar ubicación"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvChangeLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Cambiar >"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:alpha="0.85" />
            </LinearLayout>

            <!-- 3. PESTAÑAS DE CATEGORÍA -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tabAll"
                        style="@style/MarketplaceTab"
                        android:text="Todo"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tabHotel"
                        style="@style/MarketplaceTab"
                        android:text="Hotelería y Turismo"
                        android:textColor="@color/white" />
                    <TextView
                        android:id="@+id/tabProducts"
                        style="@style/MarketplaceTab"
                        android:text="Productos"
                        android:textColor="@color/white" />
                    <TextView
                        android:id="@+id/tabLoans"
                        style="@style/MarketplaceTab"
                        android:text="Préstamos"
                        android:textColor="@color/white" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshMarketplace"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section: Recently Added Shops -->
                <LinearLayout
                    android:id="@+id/layoutRecentShopsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tiendas agregadas recientemente"
                        android:textColor="@color/slate_900"
                        android:textStyle="bold"
                        android:textSize="17sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentShops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Section Title: Recently Viewed -->
                <LinearLayout
                    android:id="@+id/layoutRecentlyViewedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Visto recientemente"
                        android:textColor="@color/slate_900"
                        android:textStyle="bold"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/tvViewHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver historial"
                        android:textColor="@color/sky_600"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>

                <!-- Horizontal Recently Viewed List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentlyViewed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="24dp" />

                <!-- Section Title: Main Feed -->
                <TextView
                    android:id="@+id/tvMainFeedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inspirado en lo último que viste"
                    android:textColor="@color/slate_900"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Products Grid (Vertical) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMarketplaceGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_marketplace_grid_product" />

                <!-- Pagination / End Container -->
                <LinearLayout
                    android:id="@+id/layoutPaginationContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLoadMoreMarketplace"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargar más"
                        android:textColor="@color/gomezmart_primary"
                        app:strokeColor="@color/gomezmart_primary"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="20dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="10dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvNoMoreProductsMarketplace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Llegaste hasta el final ✨"
                        android:textColor="@color/slate_500"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/layoutLoadingStores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="?attr/colorPrimary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargando GoMezMart..."
            android:textColor="@color/slate_500"
            android:layout_marginTop="12dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
