<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutVentas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. HEADER & SEARCH SECTION -->
        <LinearLayout
            android:id="@+id/topSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Toolbar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBackVentas"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:cardBackgroundColor="@color/slate_50"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="@color/slate_900" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Punto de Venta"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900" />

                <ImageButton
                    android:id="@+id/btnOpenMenuVentas"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_more"
                    app:tint="@color/slate_600" />
            </RelativeLayout>

            <!-- Search Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/slate_100">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/slate_400" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutVentaBusqueda"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/autoVentaBusqueda"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="¿Qué vendemos hoy?"
                            android:inputType="text"
                            android:textSize="15sp"
                            android:paddingVertical="14dp"
                            android:paddingHorizontal="8dp"
                            android:background="@android:color/transparent"
                            android:completionThreshold="1"
                            android:textColor="@color/slate_900" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/btnVoiceSearchVentas"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/purple_600" />

                    <ImageButton
                        android:id="@+id/btnScanBarcodeVentas"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/slate_500" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/slate_200"
                        android:layout_marginHorizontal="4dp" />

                    <ImageButton
                        android:id="@+id/btnQuickAddManual"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/purple_600" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 2. CART ITEMS SECTION -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCartItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingVertical="20dp"
            android:paddingHorizontal="20dp"
            app:layout_constraintBottom_toTopOf="@id/paymentFooter"
            app:layout_constraintTop_toBottomOf="@id/topSection" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@id/paymentFooter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topSection">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:alpha="0.1"
                app:tint="@color/slate_900" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tu carrito está esperando..."
                android:textSize="15sp"
                android:textColor="@color/slate_400"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. PAYMENT FOOTER SECTION -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/paymentFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="24dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL A PAGAR"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_500"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/tvVentaTotalDinamico"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S/ 0.00"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_900" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPayCash"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="64dp"
                        android:text="Efectivo"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@android:drawable/ic_menu_save"
                        app:iconGravity="top"
                        android:layout_marginEnd="6dp"
                        app:backgroundTint="@color/emerald_600"
                        app:cornerRadius="12dp"
                        android:padding="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPayDigital"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="64dp"
                        android:text="Digital"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconGravity="top"
                        android:layout_marginHorizontal="4dp"
                        app:backgroundTint="@color/vibrant_purple"
                        app:cornerRadius="12dp"
                        android:padding="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPayCard"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="64dp"
                        android:text="Tarjeta"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconGravity="top"
                        android:layout_marginStart="8dp"
                        app:backgroundTint="@color/sky_600"
                        app:cornerRadius="12dp"
                        android:padding="4dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar Menu -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationViewVentas"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/menu_ventas_drawer"
        app:headerLayout="@layout/drawer_header_simple" />

</androidx.drawerlayout.widget.DrawerLayout>
