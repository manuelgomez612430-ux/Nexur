<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarEditor"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/txtToolbarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Editor - Piso 1"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevFloor"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:icon="@android:drawable/arrow_down_float"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/slate_100"
                    app:tint="@color/slate_700"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextFloor"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:icon="@android:drawable/arrow_up_float"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/slate_100"
                    app:tint="@color/slate_700"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardar"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/emerald_600"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEditorFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/slate_200"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarEditor"
        app:layout_constraintBottom_toTopOf="@id/cardTools">

        <com.gomezmart.app.util.HotelMapView
            android:id="@+id/editorMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Controles de Zoom -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardZoomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/slate_200"
        app:layout_constraintBottom_toTopOf="@id/cardTools"
        app:layout_constraintEnd_toEndOf="@id/cardEditorFrame">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:animateLayoutChanges="true">
            <LinearLayout
                android:id="@+id/layoutZoomActions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoomOut"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:text="-"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_700"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoomIn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_700"
                    android:padding="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp" />

                <View android:layout_width="1dp" android:layout_height="20dp" android:background="@color/slate_200" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnResetZoom" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_search" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/slate_700" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón de Deshacer -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUndo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/slate_200"
        app:layout_constraintBottom_toTopOf="@id/cardTools"
        app:layout_constraintStart_toStartOf="@id/cardEditorFrame">
        <ImageButton android:id="@+id/btnUndo" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_revert" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/slate_700" />
    </com.google.android.material.card.MaterialCardView>

    <!-- PANEL DE HERRAMIENTAS -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/purple_600"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true">

            <RelativeLayout
                android:id="@+id/headerTools"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingHorizontal="16dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/txtToolsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="HERRAMIENTAS"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnHeaderDelete"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_delete"
                        android:visibility="gone"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/imgExpandIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:src="@android:drawable/arrow_down_float"
                        app:tint="@color/white" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/expandableContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:visibility="gone">

                <!-- Controles de Elemento Seleccionado -->
                <LinearLayout
                    android:id="@+id/layoutElementControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layoutThickness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grosor" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/slate_500" />
                        <com.google.android.material.slider.Slider android:id="@+id/sliderThickness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="2.0" android:valueTo="40.0" android:stepSize="2.0" app:labelBehavior="gone" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleHollow" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relleno" android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleBaseWall"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:text="Sincronizar entre pisos"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:icon="@android:drawable/ic_popup_sync"
                        app:iconSize="14dp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDuplicateSelection"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="Duplicar como nueva habitación"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:icon="@android:drawable/ic_menu_add"
                        app:iconSize="18dp"
                        app:cornerRadius="16dp" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/gridMainTools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:paddingHorizontal="8dp"
                    android:layout_marginTop="8dp"
                    android:paddingBottom="16dp">

                    <!-- Pared -->
                    <LinearLayout android:id="@+id/btnAddWall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="?attr/selectableItemBackground">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FDF2F8"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🖍️"
                                android:textSize="24sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pared" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/slate_700" />
                    </LinearLayout>

                    <!-- Cuarto -->
                    <LinearLayout android:id="@+id/btnAddRoom" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="?attr/selectableItemBackground">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F0F9FF"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🏨"
                                android:textSize="24sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cuarto" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/slate_700" />
                    </LinearLayout>

                    <!-- Puerta -->
                    <LinearLayout android:id="@+id/btnAddDoor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="?attr/selectableItemBackground">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FEF3C7"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🚪"
                                android:textSize="24sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Puerta" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/slate_700" />
                    </LinearLayout>

                    <!-- Rotar -->
                    <LinearLayout android:id="@+id/btnRotate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="?attr/selectableItemBackground">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#ECFDF5"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🔄"
                                android:textSize="24sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rotar" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/slate_700" />
                    </LinearLayout>

                    <!-- Lado L/R -->
                    <LinearLayout android:id="@+id/btnFlipSide" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:visibility="gone" android:background="?attr/selectableItemBackground">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F0FDFA"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="↔️"
                                android:textSize="24sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lado L/R" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/sky_600"/>
                    </LinearLayout>

                    <!-- Abrir In/Out -->
                    <LinearLayout android:id="@+id/btnFlipOpening" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:visibility="gone" android:background="?attr/selectableItemBackground">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F5F3FF"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🔃"
                                android:textSize="24sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Abrir In/Out" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/sky_600"/>
                    </LinearLayout>

                    <!-- Duplicar -->
                    <LinearLayout android:id="@+id/btnDuplicate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="?attr/selectableItemBackground">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EEF2FF"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="📑"
                                android:textSize="24sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Duplicar" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/slate_700" />
                    </LinearLayout>

                    <!-- Borrar -->
                    <LinearLayout android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="?attr/selectableItemBackground">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FEF2F2"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🗑️"
                                android:textSize="24sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Borrar" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="#DC2626" />
                    </LinearLayout>

                </GridLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
