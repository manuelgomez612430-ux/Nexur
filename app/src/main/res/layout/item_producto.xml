<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProductoRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <CheckBox
            android:id="@+id/cbProdSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- IMAGEN -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProdItemPhoto"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toEndOf="@id/cbProdSelected"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="4dp">
            <ImageView
                android:id="@+id/ivProdItemPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="?attr/colorSurfaceContainer" />
        </com.google.android.material.card.MaterialCardView>

        <!-- INFO PRINCIPAL -->
        <LinearLayout
            android:id="@+id/layoutInfoMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/cardProdItemPhoto"
            app:layout_constraintTop_toTopOf="@id/cardProdItemPhoto"
            app:layout_constraintEnd_toStartOf="@+id/layoutPrice">

            <TextView
                android:id="@+id/tvProdItemNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Producto"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvProdItemCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textSize="11sp"
                android:textColor="@color/slate_500" />

            <!-- MARGEN DE GANANCIA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvProdItemUtility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ 25% utilidad"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_600" />
            </LinearLayout>
        </LinearLayout>

        <!-- PRECIO -->
        <LinearLayout
            android:id="@+id/layoutPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardProdItemPhoto">
            <TextView
                android:id="@+id/tvProdItemPrecioVenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 0.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_600" />
            <TextView
                android:id="@+id/tvProdItemPrecioCosto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Costo: S/ 0"
                android:textSize="10sp"
                android:textColor="@color/slate_400" />
        </LinearLayout>

        <!-- DIVISOR SUTIL -->
        <View
            android:id="@+id/dividerProd"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardProdItemPhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CONTROLES DE STOCK RÁPIDOS -->
        <LinearLayout
            android:id="@+id/layoutStockControls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/dividerProd">

            <ImageButton
                android:id="@+id/btnProdItemMinus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_surface"
                android:backgroundTint="@color/slate_100"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/slate_600"
                android:padding="8dp"
                android:scaleType="fitCenter" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStockStatus"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/emerald_50">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STOCK: "
                        android:textSize="11sp"
                        android:textColor="@color/slate_500" />
                    <TextView
                        android:id="@+id/tvProdItemStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/emerald_600" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/btnProdItemPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_surface"
                android:backgroundTint="@color/purple_600"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/white"
                android:padding="8dp"
                android:scaleType="fitCenter" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
