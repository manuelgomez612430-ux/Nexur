<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- PRODUCT INFO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCartProdName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Producto"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900" />

                <TextView
                    android:id="@+id/tvCartProdPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 0.00 c/u"
                    android:textSize="12sp"
                    android:textColor="@color/slate_500"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- QUANTITY CONTROLS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/slate_50"
                android:padding="2dp"
                android:layout_marginHorizontal="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCartMinus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:icon="@android:drawable/ic_media_previous"
                    app:iconTint="@color/red_600"
                    app:iconSize="16dp"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/tvCartQty"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/slate_900"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCartPlus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:icon="@android:drawable/ic_media_next"
                    app:iconTint="@color/purple_600"
                    app:iconSize="16dp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- SUBTOTAL -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUBTOTAL"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_400"
                    android:letterSpacing="0.1" />
                <TextView
                    android:id="@+id/tvCartSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_900" />
            </LinearLayout>
        </LinearLayout>

        <!-- STOCK WARNING (AHORA VISIBLE) -->
        <TextView
            android:id="@+id/tvStockWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⚠️ Superaste el stock disponible"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/red_600"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
