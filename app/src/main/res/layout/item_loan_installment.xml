<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInstallmentStatusColor"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/slate_200" />

        <TextView
            android:id="@+id/tvInstallmentNumber"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="1"
            android:gravity="center"
            android:background="@android:drawable/btn_star_big_off"
            android:textSize="12sp"
            android:textColor="@color/slate_400" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:id="@+id/tvInstallmentAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 50.00"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/slate_900" />
            <TextView
                android:id="@+id/tvInstallmentDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vence: 25/08/2026"
                android:textSize="11sp"
                android:textColor="@color/slate_500" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayInstallment"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="PAGAR"
            android:textSize="10sp"
            app:cornerRadius="18dp"
            app:backgroundTint="@color/emerald_50"
            android:textColor="@color/emerald_600" />

        <ImageView
            android:id="@+id/ivInstallmentStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="@color/emerald_600"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
