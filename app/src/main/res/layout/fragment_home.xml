<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeftRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.06" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRightRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.94" />

    <!-- CONTENIDO PRINCIPAL CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutVentaActions">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- FONDO DE CABECERA PREMIUM INTEGRADO -->
            <View
                android:id="@+id/topHeaderBackground"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/purple_600"
                app:layout_constraintBottom_toBottomOf="@id/cardDashboard"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- GUÍAS PORCENTUALES -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.06" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.94" />

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="@id/guidelineLeft"
                app:layout_constraintEnd_toEndOf="@id/guidelineRight"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLogoHome"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivLogoHome"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logo_sistema_productos" />

                        <View
                            android:id="@+id/viewCollabBadgeMain"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_circle_red"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWelcomeSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GoMezMart le da la bienvenida a la gestión inteligente de"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:alpha="0.8"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/tvMainBusinessName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mi Negocio"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="14sp"
                        app:autoSizeMaxTextSize="18sp"
                        android:maxLines="1"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- DASHBOARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDashboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/purple_600"
                app:cardElevation="8dp"
                app:shapeAppearance="@style/ShapeAppearance.App.Card.TopRounded"
                app:strokeWidth="2dp"
                app:strokeColor="@color/purple_600"
                app:layout_constraintStart_toStartOf="@id/guidelineLeft"
                app:layout_constraintEnd_toEndOf="@id/guidelineRight"
                app:layout_constraintTop_toBottomOf="@id/headerTitle">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <!-- VENTAS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:text="Venta total"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvVentasHoyMain"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="S/ 0.00"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="16sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:alpha="0.1"
                            android:background="@color/white" />

                        <!-- UTILIDAD -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:text="Utilidad"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvUtilidadHoyMain"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="S/ 0.00"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="16sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:alpha="0.1"
                            android:background="@color/white" />

                        <!-- GASTOS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:text="Gasto total"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGastosHoyMain"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="- S/ 0.00"
                                android:textColor="#FF8A80"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="16sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:alpha="0.1"
                            android:background="@color/white" />

                        <!-- CAPITAL -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:text="Capital"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCapitalMain"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="S/ 0.00"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="16sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnInfoDashboard"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_dialog_info"
                        android:scaleType="fitCenter"
                        android:padding="4dp"
                        app:tint="@color/white"
                        android:alpha="0.3" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN CENTRAL LIMPIA Y ORGANIZADA -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutMainBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="@id/guidelineRight"
                app:layout_constraintStart_toStartOf="@id/guidelineLeft"
                app:layout_constraintTop_toBottomOf="@id/cardDashboard">

                <!-- BOTÓN: MENSAJES (Fila 1, Izquierda) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMensajesCentral"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnDeliveriesCentral">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="📬"
                                android:textSize="24sp"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mensajes"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginTop="8dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textAlignment="center" />
                        </LinearLayout>

                        <!-- BADGE DE MENSAJES NO LEÍDOS -->
                        <TextView
                            android:id="@+id/tvUnreadBadgeHome"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_circle_red"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN: DELIVERY (Fila 1, Derecha) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnDeliveriesCentral"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnMensajesCentral"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="🛵"
                            android:textSize="24sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN: GASTOS (Fila 2, Izquierda) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnGastosCentral"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintTop_toBottomOf="@id/btnMensajesCentral"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnCompromisosCentral">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="💸"
                            android:textSize="24sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gastos"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN: COMPROMISOS (Fila 2, Centro) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnCompromisosCentral"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintTop_toBottomOf="@id/btnMensajesCentral"
                    app:layout_constraintStart_toEndOf="@id/btnGastosCentral"
                    app:layout_constraintEnd_toStartOf="@id/btnCajaCentral">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="🤝"
                            android:textSize="24sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Compromisos"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN: CAJA (Fila 2, Derecha) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnCajaCentral"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintTop_toBottomOf="@id/btnDeliveriesCentral"
                    app:layout_constraintStart_toEndOf="@id/btnCompromisosCentral"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="💰"
                            android:textSize="24sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caja"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN: DEUDORES (Fila 3, Izquierda) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnDeudoresCentral"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintTop_toBottomOf="@id/btnGastosCentral"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnHistorialCentral">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="📓"
                            android:textSize="24sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deudores"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN: HISTORIAL (Fila 3, Derecha) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnHistorialCentral"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/purple_600"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintTop_toBottomOf="@id/btnGastosCentral"
                    app:layout_constraintStart_toEndOf="@id/btnDeudoresCentral"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="📜"
                            android:textSize="24sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Historial"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/viewSpacerMain"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutMainBody" />

            <!-- FOOTER INFO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GoMezMart v1.5.52"
                android:textAlignment="center"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/viewSpacerMain"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="717dp"
                android:layout_height="81dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewSpacerMain" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutVentaActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/purple_600"
        app:cardElevation="8dp"
        app:cardCornerRadius="30dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guidelineLeftRoot"
        app:layout_constraintEnd_toEndOf="@id/guidelineRightRoot">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ÁREA: REALIZAR VENTA -->
            <LinearLayout
                android:id="@+id/btnIrVentas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvRealizarVentaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REALIZAR VENTA"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:background="@android:color/white"
                android:alpha="0.3" />

            <!-- ÁREA: ESCANEAR -->
            <FrameLayout
                android:id="@+id/btnScanVenta"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@android:color/white" />
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
