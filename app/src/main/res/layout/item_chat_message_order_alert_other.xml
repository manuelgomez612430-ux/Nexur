<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/purple_100">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NUEVO PEDIDO RECIBIDO 🔔"
                    android:textColor="@color/purple_600"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMessageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:56 p.m."
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOrderAlertText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El comprador ha realizado un pedido..."
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/slate_50" />

            <!-- BOTONES DE ACCIÓN (STAKED) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderAlertAccept"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Aceptar Pedido ✅"
                android:textStyle="bold"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/purple_600" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderAlertReject"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="Rechazar Pedido 🚫"
                android:textColor="@color/red_600"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconTint="@color/red_600" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderAlertLocation"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="Ver Ubicación 📍"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_compass" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>