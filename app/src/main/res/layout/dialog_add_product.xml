<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro de Producto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="20dp" />

            <!-- 1. NOMBRE Y FOTO (Foto a la derecha) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProdPhoto"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant">
                    <ImageView
                        android:id="@+id/ivDialogProdPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_camera"
                        android:scaleType="centerInside"
                        android:padding="16dp"
                        android:contentDescription="Tomar foto" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    style="?attr/textInputOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="Nombre del producto"
                    android:id="@+id/layoutProdNombre">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProdNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- NUEVA DESCRIPCIÓN -->
            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descripción detallada del producto"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProdDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. CÓDIGO (ESCRIBIR O ESCANEAR) -->
            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Código (Escribir o Escanear)"
                android:layout_marginBottom="8dp"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_camera"
                app:endIconContentDescription="Escanear"
                app:startIconDrawable="@android:drawable/ic_input_add"
                app:startIconContentDescription="Añadir"
                android:id="@+id/layoutProdCodigo">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProdCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- LISTA VISIBLE DE CÓDIGOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Códigos vinculados:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/layoutCodesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:paddingVertical="4dp">
                <!-- Dinámico -->
            </LinearLayout>

            <!-- CATEGORÍA (ESTILO AJUSTADO PARA DESPLIEGUE HACIA ABAJO) -->
            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedStyle"
                android:id="@+id/layoutProdCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Categoría"
                android:layout_marginBottom="16dp"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/arrow_down_float">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/autoProdCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textSize="15sp"
                    android:completionThreshold="1"
                    android:dropDownAnchor="@id/layoutProdCategoria"
                    android:dropDownVerticalOffset="2dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- STOCK Y PRECIO VENTA (JUNTOS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="?attr/textInputOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="Stock"
                    app:suffixText="uds">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProdStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="?attr/textInputOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1.2"
                    android:layout_height="wrap_content"
                    android:hint="Precio Venta"
                    android:layout_marginStart="8dp"
                    app:prefixText="S/ ">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProdVenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- CHECKS (Costo, Vence, Ubicación) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbShowBatchCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Costo?"
                    android:textSize="10sp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbShowExpiration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Vence?"
                    android:textSize="10sp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbShowLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ubicación?"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- CAMPOS OPCIONALES (HIDDEN BY DEFAULT) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutProdCosto"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Costo total lote"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:prefixText="S/ ">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProdCosto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutProdLocation"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pasillo / Estante"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProdLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutProdExpiration"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Vencimiento (DD/MM/AAAA)"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                app:endIconContentDescription="Abrir calendario">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProdExpiration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:digits="0123456789/"
                    android:maxLength="10"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvAlertStockDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/red_600"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="20dp" />

            <!-- BOTONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnDeleteProduct"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eliminar"
                    android:textColor="@color/red_600"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnCancelAdd"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="Cancelar"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnConfirmAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="Guardar"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
