<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="28dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_100">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- DECORATIVE ELEMENTS -->
        <View
            android:id="@+id/viewDecor1"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_deco_circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:translationX="40dp"
            android:translationY="-40dp" />

        <View
            android:id="@+id/viewDecor2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_deco_circle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:translationX="-30dp"
            android:translationY="30dp" />

        <View
            android:id="@+id/viewAccent"
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_accent_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvSectionTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvSectionTitle" />

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Título de Sección"
            android:textColor="@color/slate_900"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:layout_constraintStart_toEndOf="@id/viewAccent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ACTIONS ROW FOR STORE OWNER IN EDIT MODE -->
        <LinearLayout
            android:id="@+id/layoutSectionActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSectionTitle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageSectionImages"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="8dp"
                android:text="🖼️ Fotos"
                android:textColor="@color/purple_700"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_50"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditSection"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="8dp"
                android:text="✏️ Editar"
                android:textColor="@color/purple_700"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_50"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveSectionUp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="⬆️"
                android:textSize="11sp"
                app:backgroundTint="@color/slate_100"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveSectionDown"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="⬇️"
                android:textSize="11sp"
                app:backgroundTint="@color/slate_100"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierSectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvSectionTitle,layoutSectionActions" />

        <!-- IMAGE CAROUSEL -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSectionCarousel"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/barrierSectionHeader">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpSectionImages"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Animated Pager Indicator -->
        <LinearLayout
            android:id="@+id/layoutDotsIndicator"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/cardSectionCarousel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvSectionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Detalles adicionales del negocio..."
            android:textColor="@color/slate_600"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp"
            app:layout_constraintTop_toBottomOf="@id/layoutDotsIndicator" />

        <!-- SUBTLE LINE AT BOTTOM -->
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:background="@color/slate_100"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSectionContent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
