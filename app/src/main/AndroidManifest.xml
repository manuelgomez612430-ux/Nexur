<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <!-- Permisos de Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".GomezmartApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gomezmart"
        android:usesCleartextTraffic="true">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Pantalla de Bienvenida (Branding) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Gomezmart.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de Registro Unificada -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".WelcomeRoleActivity" android:exported="true" />

        <!-- Pantalla Principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Gomezmart"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ProfileSetupActivity" android:exported="true" android:label="Configuración de Perfil" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EditProfileActivity" android:exported="false" android:label="Editar mi Información" />
        <activity android:name=".OrderTrackingActivity" android:exported="false" android:label="Seguimiento de Pedido" />
        <activity android:name=".OrderTrackingFullscreenActivity" android:exported="false" android:label="Mapa a Pantalla Completa" />
        <activity android:name=".LoanDetailsActivity" android:exported="true" android:label="Detalles de Préstamo" />

        <activity android:name=".AsignadorDePreciosActivity" android:label="@string/title_asignador_precios" />
        <activity android:name=".HistorialActivity" android:label="Historial" />
        <activity
            android:name=".VentasActivity"
            android:exported="false"
            android:label="Registro de Ventas"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ResumenActivity" android:label="Rendimiento" />
        <activity android:name=".InstruccionesActivity" android:label="Instrucciones" />
        <activity android:name=".DeudoresActivity" android:label="Control de Deudas" />
        <activity android:name=".GastosActivity" android:label="Gastos del Local" />
        <activity android:name=".ProveedoresActivity" android:label="Mis Proveedores" />
        <activity android:name=".ListaComprasActivity" android:label="Mi Lista de Compras" />
        <activity android:name=".CajaActivity" android:label="Arqueo de Caja" />
        <activity android:name=".SettingsActivity" android:label="Configuración de Negocio Virtual" />
        <activity android:name=".BusinessSelectionActivity" android:exported="false" android:theme="@style/Theme.Gomezmart" />
        <activity android:name=".DownloadedModulesActivity" android:exported="false" android:label="Módulos Descargados" />
        <activity android:name=".AccountSettingsActivity" android:exported="false" android:label="Configuración de Cuenta" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DeleteDataOrAccountActivity" android:exported="false" android:label="Eliminación de Datos o Cuenta" />
        <activity android:name=".NotificationSettingsActivity" android:exported="false" android:label="Ajustes de Notificaciones" />
        <activity android:name=".PdfViewerActivity" android:exported="false" android:label="Vista Previa PDF" />

        <activity android:name=".FutureVisionActivity" android:exported="false" android:theme="@style/Theme.Gomezmart" />
        <activity android:name=".CustomersActivity" android:label="Mis Clientes VIP" />
        <activity android:name=".SalesHistoryActivity" android:label="Historial de Ventas" />
        <activity android:name=".MovementsActivity" android:label="Historial de Movimientos" />
        <activity android:name=".EmitirComprobanteActivity" android:label="Emitir Comprobante" />
        <activity android:name=".AddProductActivity" android:label="Producto" />
        <activity android:name=".MailboxActivity" android:label="Buzón de Mensajes" />
        <activity android:name=".MessageDetailActivity" android:label="Detalle de Mensaje" />
        <activity android:name=".BusinessDebtsActivity" android:label="Mis Cuentas por Pagar" />
        <activity android:name=".CommitmentsActivity" android:exported="false" android:label="Mis Compromisos" />
        <activity android:name=".AccountsActivity" android:exported="false" android:label="Mis Cuentas" />
        <activity android:name=".FinancialReorganizationActivity" android:exported="false" android:label="Reorganización Financiera" />
  <activity android:name=".MetricsDetailActivity" android:exported="false" android:label="Detalle de Rendimiento" />
        <activity android:name=".BuyerHomeActivity"
            android:exported="false"
            android:label="Gomezmart: Compras"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".CartCheckoutActivity" android:exported="false" android:label="Mi Pedido" />
        <activity
            android:name=".ProductDetailActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Detalle del Producto">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gomezmart.app" android:pathPrefix="/producto" />
                <data android:scheme="http" android:host="gomezmart.app" android:pathPrefix="/producto" />
                <data android:scheme="https" android:host="www.gomezmart.app" android:pathPrefix="/producto" />
                <data android:scheme="http" android:host="www.gomezmart.app" android:pathPrefix="/producto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gomezmart" android:host="producto" />
            </intent-filter>
        </activity>
        <activity
            android:name=".StoreProfileActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Perfil del Negocio">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gomezmart.app" android:pathPrefix="/tienda" />
                <data android:scheme="http" android:host="gomezmart.app" android:pathPrefix="/tienda" />
                <data android:scheme="https" android:host="www.gomezmart.app" android:pathPrefix="/tienda" />
                <data android:scheme="http" android:host="www.gomezmart.app" android:pathPrefix="/tienda" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gomezmart" android:host="tienda" />
            </intent-filter>
        </activity>
        <activity android:name=".StoreEditorActivity" android:exported="false" android:label="Editor de Tienda" />
        <activity android:name=".LoanStoreProfileActivity" android:exported="false" android:label="Perfil de Financiera" />
        <activity android:name=".LoanStoreEditorActivity" android:exported="false" android:label="Editor de Financiera" />
        <activity android:name=".SearchBusinessActivity" android:exported="false" android:label="Buscar Negocio" />
        <activity android:name=".MyBusinessesActivity" android:exported="false" android:label="Mis Sistemas" />
        <activity android:name=".BuyerBookingsActivity" android:exported="false" android:label="Mis Reservas" />
        <activity android:name=".ManageLocationsActivity" android:exported="false" android:label="Mis Ubicaciones" />
        <activity android:name=".AddLocationActivity" android:exported="false" android:label="Agregar Ubicación" />
        <activity android:name=".BusinessMapSelectorActivity" android:exported="false" android:label="Seleccionar Ubicación del Negocio" />
        <activity android:name=".CollabAccountActivity" android:exported="false" android:label="Mi Cuenta" />
        <activity android:name=".ViewedHistoryActivity" android:exported="false" android:label="Historial de navegación" />
        <activity android:name=".DeliveriesActivity" android:exported="false" android:label="Gestión de Entregas" />
        <activity android:name=".BuyerOrdersActivity" android:exported="false" android:label="Mis Pedidos" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="Chat con Negocio"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AiChatActivity"
            android:exported="false"
            android:label="Asesor IA"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SearchUsersActivity" android:exported="false" android:label="Agregar Usuario" />
        <activity android:name=".BuyerFavoritesActivity" android:exported="false" android:label="Mis Favoritos" />
        <activity android:name=".TutorialActivity" android:exported="false" android:theme="@style/Theme.Gomezmart" />

        <!-- Actividad para Recorte de Imágenes -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />

        <!-- Anular restricción de orientación portrait de GmsBarcodeScanningDelegateActivity para pantallas grandes (Android 16+) -->
        <activity
            android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity"
            android:screenOrientation="unspecified"
            tools:replace="android:screenOrientation" />

        <!-- Servicio para Notificaciones Push (FCM) -->
        <service
            android:name=".network.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Configuración predeterminada de Notificaciones Push (FCM) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="gomezmart_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_gomezmart" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/gomezmart_primary" />



        <receiver
            android:name=".network.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
